# Neo4j 연결 정보 (Neo4j Desktop 기본값)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here

# Anthropic LLM API 키 (선택사항 — 없으면 드롭다운 수동 입력 모드)
# NEXT_PUBLIC_ 접두사 절대 금지 (클라이언트 번들 노출 위험)
LLM_API_KEY=sk-ant-api03-...

# 사용할 Claude 모델
LLM_MODEL=claude-sonnet-4-6

# 웹앱 포트 (기본 3000)
NEXT_PUBLIC_APP_PORT=3000

# MCP 서버가 ViewEvent를 발송할 웹앱 주소
WEB_APP_URL=http://localhost:3000
